# Optional real RAG endpoint. The smoke test uses the mock client instead.
RAG_ENDPOINT=http://localhost:8000/query

# Optional LLM key for future LLM-as-judge integration.
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# Medical LLM Providers configuration:
# Single provider: deepseek | glm | openai | gemini
MEDICAL_LLM_PROVIDER=deepseek
# Multi-provider failover chain (comma-separated, tried in order):
MEDICAL_LLM_PROVIDERS=deepseek,glm,openai

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Zhipu AI / GLM (GLM-4, GLM-4-Flash, GLM-4-Plus)
ZHIPUAI_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Copilot/GitHub Models: use a GitHub token with models:read permission.
GITHUB_TOKEN=
GITHUB_MODELS_API_BASE=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Optional generic fallback for third-party OpenAI-compatible gateways.
API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Medical program runtime.
MEDICAL_KNOWLEDGE_PATH=data/level_a_medical_knowledge.json
MEDICAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEDICAL_EMBEDDING_CACHE=models/fastembed
MEDICAL_LTP_MODEL=LTP/small
MEDICAL_LTP_CACHE=models/ltp
# Set to 1 in deployments where LTP must load successfully; default 0 allows observable fallback.
MEDICAL_LTP_REQUIRED=0
QDRANT_PATH=.cache/qdrant
QDRANT_COLLECTION=medical_knowledge_v1
MEDICAL_WEB_SEARCH_MODE=mcp
NCBI_EMAIL=
NCBI_API_KEY=

# MySQL 8 knowledge governance database.
# MYSQL_DATABASE_URL overrides the individual MYSQL_* values when set.
MYSQL_DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agentic_rag
MYSQL_PASSWORD=agentic_rag_dev
MYSQL_DATABASE=agentic_rag_medical
